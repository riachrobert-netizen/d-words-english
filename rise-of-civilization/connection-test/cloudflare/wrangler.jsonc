{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "rise-civ-connection-test",
  "main": "./src/worker.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "Rooms" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Rooms"] }]
}
